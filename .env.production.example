# ===============================================
# PolyPack Billing - Production VPS Environment
# ===============================================

# Port for the Node/Express server on VPS
PORT=5025

# Local MongoDB instance running on your VPS
# Default local MongoDB connection (database named polybag_billing):
MONGODB_URI=mongodb://127.0.0.1:27017/polybag_billing

# If your local MongoDB has authentication enabled:
# MONGODB_URI=mongodb://username:strongPassword@127.0.0.1:27017/polybag_billing?authSource=admin

